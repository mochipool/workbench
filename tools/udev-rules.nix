# One udev rules file covering the hardware wallets the workbench supports
# (Ledger and Trezor over USB). Built from nixpkgs' maintained rule sets so
# they track upstream. Keystone needs no rules: it signs via QR code and its
# firmware updates go through microSD or the browser (WebUSB).
#
# Linux only. Rules grant the logged-in user access through the `uaccess`
# tag, so no group membership or sudo is needed at runtime.
{ pkgs }:
pkgs.runCommand "cardano-spo-workbench-udev-rules" { } ''
  dir=$out/lib/udev/rules.d
  mkdir -p $dir
  {
    echo "# Cardano SPO Workbench: Ledger + Trezor access for the logged-in user."
    echo "# Generated by nix from nixpkgs' ledger-udev-rules and trezor-udev-rules."
    echo
    cat ${pkgs.ledger-udev-rules}/lib/udev/rules.d/20-ledger.rules
    echo
    cat ${pkgs.trezor-udev-rules}/lib/udev/rules.d/51-trezor.rules
  } > $dir/70-cardano-spo-workbench.rules
''
